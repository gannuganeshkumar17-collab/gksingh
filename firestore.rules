rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'balance',
        'totalDeposited',
        'totalWithdrawn',
        'gamesPlayed',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'phone',
        'phoneVerified',
        'balance',
        'totalDeposited',
        'totalWithdrawn',
        'gamesPlayed',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid == userId && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && (!('email' in data) || (data.email is string && data.email.size() <= 120))
      && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
      && (!('phoneVerified' in data) || data.phoneVerified is bool)
      && data.balance is number && data.balance >= 0 && data.balance <= 100000000
      && data.totalDeposited is number && data.totalDeposited >= 0 && data.totalDeposited <= 100000000
      && data.totalWithdrawn is number && data.totalWithdrawn >= 0 && data.totalWithdrawn <= 100000000
      && data.gamesPlayed is number && data.gamesPlayed >= 0 && data.gamesPlayed <= 10000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidWalletTransaction(data, userId, txId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'type',
        'amount',
        'method',
        'reference',
        'status',
        'balanceAfter',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'userId',
        'type',
        'amount',
        'method',
        'reference',
        'gameName',
        'status',
        'balanceAfter',
        'createdAt'
      ])
      && data.id is string && data.id == txId && isValidId(data.id)
      && data.userId is string && data.userId == userId && isValidId(data.userId)
      && data.type in ['deposit', 'withdraw', 'bet', 'win', 'bonus']
      && data.amount is number && data.amount >= 0 && data.amount <= 10000000
      && data.method is string && data.method.size() >= 1 && data.method.size() <= 60
      && data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 120
      && (!('gameName' in data) || (data.gameName is string && data.gameName.size() <= 60))
      && data.status in ['completed', 'pending', 'failed']
      && data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 100000000
      && data.createdAt == request.time;
    }

    function isValidGameRound(data, userId, roundId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'gameId',
        'variant',
        'betAmount',
        'payout',
        'outcome',
        'summary',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'userId',
        'gameId',
        'variant',
        'betAmount',
        'payout',
        'outcome',
        'summary',
        'createdAt'
      ])
      && data.id is string && data.id == roundId && isValidId(data.id)
      && data.userId is string && data.userId == userId && isValidId(data.userId)
      && data.gameId is string && data.gameId.size() >= 1 && data.gameId.size() <= 40
      && data.variant is string && data.variant.size() >= 1 && data.variant.size() <= 60
      && data.betAmount is number && data.betAmount >= 0 && data.betAmount <= 10000000
      && data.payout is number && data.payout >= 0 && data.payout <= 100000000
      && data.outcome in ['win', 'loss', 'draw']
      && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 160
      && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().balance == 10
        && incoming().totalDeposited == 0
        && incoming().totalWithdrawn == 0
        && incoming().gamesPlayed == 0;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'phoneVerified', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalDeposited', 'totalWithdrawn', 'gamesPlayed', 'updatedAt']))
        );

      allow delete: if false;

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(txId)
          && isOwner(userId)
          && isValidWalletTransaction(incoming(), userId, txId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }

      match /gameRounds/{roundId} {
        allow get: if isValidId(userId) && isValidId(roundId) && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(roundId)
          && isOwner(userId)
          && isValidGameRound(incoming(), userId, roundId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }
    }
  }
}
